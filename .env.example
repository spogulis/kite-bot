# Copy to .env and fill in. Get a token from @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME

# Mini App tunnel (optional, README "Mini App"): the token Cloudflare shows
# when you create the tunnel, and the compose profile that starts cloudflared.
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=webapp
